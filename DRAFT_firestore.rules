rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      // Bootstrapped admin email
      return isEmailVerified() && request.auth.token.email == 'seonsnn@gmail.com';
    }

    function isSeller() {
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'seller';
    }

    // --- Validation Blueprints ---

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'fullName', 'role', 'createdAt']) &&
             data.keys().size() == 5 &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 200 &&
             data.fullName is string && data.fullName.size() <= 100 &&
             data.role in ['customer', 'seller'] &&
             data.createdAt is number;
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['id', 'sellerId', 'name', 'price', 'category', 'stock', 'createdAt']) &&
             data.id is string && data.id.size() <= 64 &&
             data.sellerId == request.auth.uid &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.category is string &&
             data.stock is number && data.stock >= 0 &&
             data.createdAt is number &&
             (!data.keys().contains('originalPrice') || data.originalPrice is number) &&
             (!data.keys().contains('images') || (data.images is list && data.images.size() <= 10));
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['id', 'customerId', 'items', 'totalAmount', 'status', 'paymentMethod', 'shippingAddress', 'createdAt']) &&
             data.id is string &&
             data.customerId == request.auth.uid &&
             data.items is list && data.items.size() > 0 && data.items.size() <= 50 &&
             data.totalAmount is number &&
             data.status in ['pending', 'confirmed', 'shipped', 'delivered', 'cancelled'] &&
             data.paymentMethod in ['COD', 'UPI', 'CARD', 'WALLET'] &&
             data.shippingAddress is string && data.shippingAddress.size() <= 500 &&
             data.createdAt is number;
    }

    function isValidReview(data) {
      return data.keys().hasAll(['id', 'productId', 'userId', 'rating', 'timestamp']) &&
             data.id is string &&
             data.userId == request.auth.uid &&
             data.rating is number && data.rating >= 1 && data.rating <= 5 &&
             data.timestamp is number;
    }

    // --- Rules ---

    // Users
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['fullName', 'phoneNumber', 'address']);
      allow delete: if isAdmin();
    }

    // Products
    match /products/{productId} {
      allow read: if true; // Public catalog
      allow create: if isSeller() && isValidProduct(incoming());
      allow update: if (isSeller() && existing().sellerId == request.auth.uid && isValidProduct(incoming())) || isAdmin();
      allow delete: if (isSeller() && existing().sellerId == request.auth.uid) || isAdmin();

      // Reviews subcollection
      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isEmailVerified() && isValidReview(incoming());
        allow update, delete: if isOwner(existing().userId) || isAdmin();
      }
    }

    // Orders
    match /orders/{orderId} {
      allow get: if isOwner(existing().customerId) || isSeller() || isAdmin();
      allow list: if isSignedIn() && (resource.data.customerId == request.auth.uid || isAdmin());
      allow create: if isEmailVerified() && isValidOrder(incoming());
      allow update: if isAdmin() || (isSeller() && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'trackingNumber']));
    }
  }
}
