{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Stores user profile information, roles, and preferences.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Unique identifier for the user." },
        "email": { "type": "string", "format": "email" },
        "fullName": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "seller", "customer"] },
        "phoneNumber": { "type": "string" },
        "address": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["uid", "email", "fullName", "role", "createdAt"]
    },
    "Product": {
      "title": "Product",
      "description": "Represents an item for sale in the marketplace.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "sellerId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "stock": { "type": "number" },
        "ratings": { "type": "number" },
        "numReviews": { "type": "number" },
        "isFlashDeal": { "type": "boolean" },
        "isTrending": { "type": "boolean" },
        "status": { "type": "string", "enum": ["draft", "published", "out_of_stock"] },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "sellerId", "name", "price", "category", "stock", "status", "createdAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Represents a purchase transaction.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "items": { 
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "productId": { "type": "string" },
              "quantity": { "type": "number" },
              "priceAtPurchase": { "type": "number" },
              "name": { "type": "string" },
              "image": { "type": "string" }
            }
          }
        },
        "totalAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "shipped", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string", "enum": ["COD", "UPI", "CARD", "WALLET"] },
        "shippingAddress": { "type": "string" },
        "trackingNumber": { "type": "string" },
        "createdAt": { "type": "number" }
      },
      "required": ["id", "customerId", "items", "totalAmount", "status", "paymentMethod", "shippingAddress", "createdAt"]
    },
    "Review": {
      "title": "Review",
      "description": "A user's review for a product.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "timestamp": { "type": "number" }
      },
      "required": ["id", "productId", "userId", "rating", "timestamp"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles."
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Product catalog."
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Customer orders."
    },
    "products/{productId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Reviews for products."
    }
  }
}
